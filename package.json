{
  "name": "the-last-elevator",
  "version": "1.0.0",
  "private": true,
  "description": "The Last Elevator: Floor 13 — a Vietnamese browser horror deduction game.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node --check dist/game.js && node --check tests/gameplay-regression.cjs",
    "test": "node --test tests/gameplay-regression.cjs",
    "test:webkit": "BROWSER=webkit node --test tests/gameplay-regression.cjs",
    "dev": "wrangler dev --port 8787",
    "deploy:check": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "playwright": "1.61.1",
    "wrangler": "4.156.1"
  }
}
